# ═══════════════════════════════════════════════════════════════════
# 여행각 백엔드 환경변수 전체 목록. 실제로 배포할 땐 이 파일을 .env로 복사한 뒤 값을 채우세요
# (로컬: `cp .env.example .env` / Render·Railway: 대시보드 Environment 탭에 하나씩 입력).
#
# 【지금 당장 채워야 실제로 작동하는 필수 항목 3개】
#   GEMINI_API_KEY     → 챗봇이 실제 AI로 답하려면 필수 (없으면 데모 응답만)
#   JWT_SECRET         → 로그인 기능 자체가 필수로 요구 (없으면 로그인 500 에러)
#   ALLOWED_ORIGIN / FRONTEND_ORIGIN / BACKEND_PUBLIC_URL → 배포 후 실제 주소로 채워야 CORS/로그인 팝업이 정상 동작
#
# 【나머지는 전부 선택】 — 비워두면 각 기능이 자동으로 데모/로컬 데이터 모드로 폴백되고,
# 서버 기동이나 다른 기능에는 전혀 영향을 주지 않습니다. 필요한 것부터 하나씩 채우면 됩니다.
# ═══════════════════════════════════════════════════════════════════

# ── AI 모델 API 키 (필수) ─────────────────────────────────────────
# Google Gemini API 키 (무료). https://aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=AIza여기에-실제-키-입력

# ── 서버 설정 ─────────────────────────────────────────────────
PORT=3000
# 프론트엔드(웹사이트) 도메인. CORS 허용 대상. 배포 후 실제 도메인으로 교체.
ALLOWED_ORIGIN=https://travelgak.netlify.app

# ── 관리자 백오피스 인증 ─────────────────────────────────────────
# admin.html 접근 시 사용할 간단한 비밀번호 (실서비스 전환 시 세션/JWT 기반 인증으로 교체 권장)
ADMIN_PASSWORD=change-me-please

# ── 사용자 로그인 (네이버/카카오 지연 로그인) ────────────────────────────
# 로그인 세션 토큰 서명에 쓰는 비밀키. 아무 무작위 긴 문자열이나 사용 (예: openssl rand -hex 32)
JWT_SECRET=
# 이 백엔드가 실제로 배포된 주소. OAuth redirect_uri를 만드는 데 필요 (예: https://travel-gak-backend.onrender.com)
BACKEND_PUBLIC_URL=
# 로그인 팝업이 postMessage를 보낼 프론트엔드 주소 (예: https://travelgak.netlify.app). 비워두면 모든 origin 허용(개발용, 배포 시 반드시 채울 것)
FRONTEND_ORIGIN=
# 네이버 개발자센터(https://developers.naver.com/apps)에서 "네이버 로그인" API 사용 설정 후 발급
# Callback URL은 {BACKEND_PUBLIC_URL}/auth/naver/callback 으로 등록
NAVER_LOGIN_CLIENT_ID=
NAVER_LOGIN_CLIENT_SECRET=
# 카카오 개발자센터(https://developers.kakao.com/console/app)에서 앱 생성 후 "카카오 로그인" 활성화
# Redirect URI는 {BACKEND_PUBLIC_URL}/auth/kakao/callback 으로 등록. REST API 키를 CLIENT_ID에 사용
KAKAO_LOGIN_CLIENT_ID=
KAKAO_LOGIN_CLIENT_SECRET=

# ── 상담원 에스컬레이션 알림 ───────────────────────────────────────
# 환불/컴플레인 등 AI가 처리 불가한 문의 발생 시 이 URL로 알림을 POST함.
# Slack "Incoming Webhook" URL을 넣으면 슬랙 채널로 바로 알림이 옵니다.
# (Slack 외 다른 서비스를 쓰면 그 서비스의 웹훅 URL로 교체하세요)
ADMIN_ALERT_WEBHOOK_URL=

# ── 카카오톡 채널 챗봇 (Kakao i 오픈빌더) ───────────────────────────
# 오픈빌더 스킬 서버 등록 시 별도 인증 토큰을 요구하지 않지만,
# 원치 않는 외부 호출을 막기 위한 자체 검증용 시크릿 (선택)
KAKAO_SKILL_SECRET=change-me-too

# ── 맛집/관광지 실시간 평점·주소 (Google Places API) ──────────────────────
# Google Cloud Console(https://console.cloud.google.com)에서 "Places API (New)" 활성화 후
# API 키 발급. 비워두면 챗봇이 맛집/관광지 답변 시 평점·주소를 "확인 필요"로 표기하고
# 지도 링크만 장소명 검색으로 대체한다 (에러 없이 정상 동작, 데이터만 덜 정확해짐).
GOOGLE_PLACES_API_KEY=
# 월 무료 한도(기본 5,000건) 초과 방지용 안전 상한. 비워두면 4500건에서 자동으로 호출을 멈춘다.
GOOGLE_PLACES_MONTHLY_CAP=4500

# ── 숙소 실시간 검색 (Agoda / Booking.com / HotelsCombined) ────────────────
# 셋 중 실제로 파트너 승인을 받은 곳 하나를 선택. 비워두면 프론트엔드가 로컬 예시 데이터로 자동 폴백.
HOTEL_API_PROVIDER=
# Agoda Partner Hub(https://partners.agoda.com)에서 발급
AGODA_SITE_ID=
AGODA_API_KEY=
# Booking.com Partner Hub에서 발급 (Demand API는 별도 심사 필요)
BOOKING_API_KEY=
# HotelsCombined / Skyscanner 제휴 프로그램에서 발급
HOTELSCOMBINED_API_KEY=

# ── 네이버 블로그/카페 검색 (Open API) + AI 요약 ──────────────────────────
# https://developers.naver.com/apps 에서 애플리케이션 등록 후 "검색" API 사용 설정 시 발급.
# 비워두면 /api/local-blog-feed가 503을 반환하고, 프론트엔드가 다낭/나트랑 Mock Data로 자동 폴백.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# OpenAI API 키. https://platform.openai.com 에서 발급. 저작권 이슈 방지를 위해 네이버 검색 결과의
# 발췌문(description)만 입력으로 사용해 "핵심 꿀팁 3줄 요약"+키워드를 생성한다.
# 비워두면 네이버 발췌문을 그대로 요약으로 사용하고 aiSummarized:false를 내려준다.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── 외교부 해외안전여행 API (일일 자동 갱신 크론, src/cron.js) ────────────────
# 공공데이터포털(https://www.data.go.kr/data/15000827/openapi.do)에서
# "외교부_여행경보제도" API 활용신청 후 발급되는 서비스 URL/인증키를 그대로 입력.
# 신청 전에는 정확한 URL을 알 수 없어 비워두는 게 기본값 — 비워두면 크론이 이 항목만 건너뛴다.
MOFA_API_URL=
MOFA_API_KEY=

# ── 행정안전부 착한가격업소 API (국내 여행지 맛집/카페 탭, src/routes/goodPriceStores.js) ──
# 공공데이터포털(https://www.data.go.kr/data/3045247/fileData.do)에서
# "행정안전부_착한가격업소 현황" OpenAPI 활용신청 후 발급되는 서비스 URL/인증키를 그대로 입력.
# 신청 전에는 정확한 URL을 알 수 없어 비워두는 게 기본값 — 비워두면 국내 도시 선택 시
# 목데이터(GOOD_PRICE_STORE_DATA)로 자동 폴백한다.
GOOD_PRICE_API_URL=
GOOD_PRICE_API_KEY=
